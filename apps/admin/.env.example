# Supabase on Vercel: transaction pooler port 6543. Migration DIRECT_URL stays separate.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_PUBLICATION_ENABLED=false
# Opt in to sharing website-published public notices with the mobile app.
APP_PUBLIC_NOTICES_ENABLED=false
APP_PUBLIC_BULLETINS_ENABLED=false
APP_PUBLIC_EVENTS_ENABLED=false
APP_PUBLIC_CHURCH_ENABLED=false
APP_PUBLIC_PRAYERS_ENABLED=false
APP_MEMBER_RECORDS_ENABLED=false
APP_MEMBER_NOTIFICATIONS_ENABLED=false
APP_MEMBER_ALLOWED_ORIGINS=
INQUIRY_RETENTION_DAYS=365
# Real groups stay off until actual names and managers are configured.
APP_GROUPS_ENABLED=false
# Care intake requires explicit assigned admin IDs and approved retention/consent.
APP_MEMBER_CARE_ENABLED=false
APP_MEMBER_CARE_POLICY=
# Account setup requires approved policy JSON, SMTP and OTP email templates.
APP_ACCOUNT_ENABLED=false
APP_ACCOUNT_EMAIL_READY=false
APP_ACCOUNT_POLICY=
APP_ACCOUNT_RATE_LIMIT_SALT=
# Deletion stays disabled until its reviewed policy, worker schedule and provider test are ready.
APP_ACCOUNT_DELETION_ENABLED=false
APP_ACCOUNT_DELETION_WORKER_READY=false
APP_ACCOUNT_DELETION_POLICY=
SUPABASE_SECRET_KEY=
# Remote push: enable only after Expo/FCM setup and a deployed 5-minute worker schedule.
APP_PUSH_ENABLED=false
APP_PUSH_WORKER_READY=false
APP_PUSH_WORKER_SECRET=
EXPO_PUSH_PROJECT_ID=
# Optional Expo enhanced push security access token (SERVER ONLY).
EXPO_PUSH_ACCESS_TOKEN=
