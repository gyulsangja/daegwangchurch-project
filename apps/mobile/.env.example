# Android emulator: http://10.0.2.2:3001
# Physical device: use the API host's reachable LAN address or HTTPS URL.
# The public API must be enabled and content explicitly published for APP.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
# Shared public live status from the website; no YouTube API key belongs in the app.
EXPO_PUBLIC_WEBSITE_URL=https://daegwangchurch.kr
# Optional member login. Public publishable key only; NEVER use service_role/secret keys.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public EAS project UUID, also set EXPO_PUSH_PROJECT_ID on the API server.
EXPO_PUBLIC_EAS_PROJECT_ID=
# File path from EAS file environment variable or local ignored Firebase config.
GOOGLE_SERVICES_JSON=
# Set these before registering apps with Firebase/Apple; keep stable afterwards.
APP_ANDROID_PACKAGE=org.daegwangchurch.app
APP_IOS_BUNDLE_ID=org.daegwangchurch.app
