{
  "name": "daegwang-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev:website",
    "dev:website": "npm run dev --workspace @daegwang/website",
    "dev:admin": "npm run dev --workspace @daegwang/admin",
    "dev:mobile": "npm run start --workspace @daegwang/mobile",
    "dev:mobile:preview": "node --import tsx scripts/preview-mobile.mjs",
    "build": "npm run db:generate && npm run build:website && npm run build:admin",
    "build:website": "npm run build --workspace @daegwang/website",
    "build:admin": "npm run build --workspace @daegwang/admin",
    "start:website": "npm run start --workspace @daegwang/website",
    "start:admin": "npm run start --workspace @daegwang/admin",
    "test": "tsx --test packages/contracts/src/lib/youtube/parser.test.ts packages/server/src/features/worship/service.test.ts packages/api-client/src/worship.test.ts packages/server/src/features/notices/app.test.ts packages/api-client/src/notices.test.ts packages/server/src/features/bulletins/app.test.ts packages/server/src/features/events/app.test.ts packages/server/src/features/church/app.test.ts packages/server/src/features/worship/app-search.test.ts packages/server/src/features/member/record.test.ts packages/server/src/features/member/account.test.ts packages/server/src/features/member/deletion.test.ts packages/api-client/src/member.test.ts packages/server/src/features/member/bookmark.test.ts packages/server/src/features/member/schedule.test.ts && npm run test:push && npm run test:preview",
    "test:mobile": "tsx --test packages/api-client/src/worship.test.ts packages/api-client/src/notices.test.ts",
    "test:integration:worship": "node tests/integration/run-worship-integration.mjs",
    "test:integration:worship:http": "node tests/integration/run-http-suite.mjs",
    "lint": "eslint packages tests scripts && npm run lint --workspaces --if-present",
    "type-check": "tsc --project tsconfig.shared.json && npm run type-check --workspaces --if-present",
    "db:generate": "npm run generate --workspace @daegwang/database",
    "db:migrate": "npm run migrate --workspace @daegwang/database",
    "db:deploy": "npm run deploy --workspace @daegwang/database",
    "db:seed": "npm run seed --workspace @daegwang/database",
    "db:studio": "npm run studio --workspace @daegwang/database",
    "postinstall": "npm run db:generate",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:preview": "tsx --test tests/member-preview.test.ts tests/offline-ux.test.ts",
    "dev:admin:preview": "node scripts/preview-admin.mjs",
    "test:integration:local": "node tests/integration/run-local-postgres.mjs",
    "check:release": "tsx scripts/check-release.mjs",
    "maintain:members": "node scripts/maintain-member-data.mjs",
    "maintain:deletions": "tsx scripts/process-member-deletions.ts",
    "test:push": "tsx --test packages/server/src/features/member/push.test.ts && node --test tests/push-readiness.test.mjs",
    "check:push": "node scripts/check-push.mjs",
    "maintain:push": "tsx scripts/process-push.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "@playwright/test": "^1.63.0"
  },
  "overrides": {
    "@hono/node-server": ">=1.19.13",
    "postcss": ">=8.5.10"
  }
}
